# Mock server base URL. The dev server proxies /api and /ws to it.
MOCK_SERVER_URL=http://localhost:4020

# Where the UI gets its data: `mock` serves static mock data with no server,
# `server` talks to the mock server at MOCK_SERVER_URL. Switch once the backend is up.
VITE_DATA_SOURCE=mock

# Optional top bar label. Keep it equal to the server's COMDOVE_WEBHOOK_URL; hidden when empty.
VITE_WEBHOOK_URL=
# Where the admin data comes from: "sample" (built-in fake data) or "server" (the real mock server).
VITE_DATA_SOURCE=sample

# Comdove webhook URL shown in the top bar. The server does not expose it yet (see docs/admin-ui-plan.md §10).
VITE_WEBHOOK_URL=http://localhost:3000/webhooks/whatsapp
